# =====================================================
# MCP Factory - Environment Configuration
# Copy this file to .env and fill in your values
# =====================================================

# Ollama server URL (default: local)
OLLAMA_BASE_URL=http://localhost:11434

# Model overrides (optional - system auto-detects best available)
# MODEL_ORCHESTRATOR=llama3.3:70b
# MODEL_CODER=qwen2.5-coder:32b

# Project root (optional; defaults to directory containing pyproject.toml)
# MCP_FACTORY_ROOT=

# Output paths (optional; defaults are relative to project root)
# GENERATED_DIR=generated/mcps
# REGISTRY_PATH=registry/mcp_registry.json
# EVENT_LOG_DIR=logs/events

# Max validation retries before giving up
MAX_VALIDATION_RETRIES=3

# Thread pool size for parallel agent workloads (scouts, RAG, design baseline)
AGENT_THREAD_POOL_SIZE=4

# Orchestration mode: langgraph (default) | events
# langgraph — LangGraph StateGraph drives the pipeline; events are observability logs
# events      — fixed lifecycle handlers react to domain events (see README.md)
ORCHESTRATION_MODE=langgraph

# GitHub API token (recommended for downloading docs / scouts)
# Create at: GitHub → Settings → Developer settings → Personal access tokens
# Scopes: public repos (read) is enough for sync scripts
# GITHUB_TOKEN=ghp_xxxxxxxx
